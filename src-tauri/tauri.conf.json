{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAS VocRep",
  "version": "0.4.0",
  "identifier": "com.nas.vocrep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NAS VocRep",
        "width": 1440,
        "height": 1024,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwNUY3QjE5OTNCODNCOTAKUldTUU83aVRHWHRmRUZDYUpqWGNua0wvYmxrMFQrWnN2SWt1SU04UFZqUElueVpYYW0yMy83ZU8K",
      "endpoints": [
        "https://github.com/sufyanaser/vocrep/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
